@model LoginVm
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
    bool registro = ViewBag.RegistroHabilitado is true;
}

<div class="auth">
    <partial name="_AuthBrand" />

    <section class="auth-form-side">
        <div class="auth-form">
            <div class="auth-mobile-logo align-items-center gap-2">
                <partial name="_Logo" />
                <span class="brand-name">Mis<span class="dot">·</span><span class="light">Gastos</span></span>
            </div>

            <h2>Iniciar sesión</h2>
            <p class="lead-x">Ingresa con tu correo para ver tus gastos.</p>

            <div asp-validation-summary="ModelOnly" class="alert-x err validation-box" role="alert"></div>

            <form method="post" asp-action="Login" novalidate data-validate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <div class="input-icon">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input asp-for="Email" class="form-control" type="email" placeholder="tu@correo.com" autocomplete="username" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <div class="input-icon">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" required style="padding-right:44px" />
                        <button type="button" class="toggle-pass" aria-label="Mostrar contraseña" data-toggle-pass><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label text-2">Mantener la sesión iniciada en este dispositivo</label>
                </div>
                <button class="btn btn-primary btn-lg w-100" type="submit">Iniciar sesión <i class="bi bi-arrow-right"></i></button>
            </form>

            @if (registro)
            {
                <p class="auth-switch">¿No tienes cuenta? <a asp-action="Registro">Crear una cuenta</a></p>
            }
        </div>
    </section>
</div>
