@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Control de gastos";
}

<div class="auth">
    <partial name="_AuthBrand" />

    <section class="auth-form-side">
        <div class="auth-form">
            <div class="auth-mobile-logo align-items-center gap-2">
                <partial name="_Logo" />
                <span class="brand-name">Mis<span class="dot">·</span><span class="light">Gastos</span></span>
            </div>

            <h2>Bienvenido</h2>
            <p class="lead-x">Lleva el control de tus tarjetas, cuotas y gastos fijos en un solo lugar.</p>

            <div class="d-grid gap-2">
                <a class="btn btn-primary btn-lg" asp-controller="Cuenta" asp-action="Login">Iniciar sesión <i class="bi bi-arrow-right"></i></a>
                <a class="btn btn-light btn-lg" asp-controller="Cuenta" asp-action="Registro">Crear una cuenta</a>
            </div>
        </div>
    </section>
</div>
