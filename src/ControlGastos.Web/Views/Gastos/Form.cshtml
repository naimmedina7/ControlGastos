@model GastoFormVm
@{
    bool editando = Model.Id.HasValue;
    ViewData["Title"] = editando ? "Editar gasto" : "Nuevo gasto";
    ViewData["Section"] = "Gastos";
    ViewData["OcultarFab"] = true;
    string accion = editando ? "Editar" : "Nuevo";
    // Sugerencias para autocompletar: viajan como JSON en un atributo (la CSP no permite scripts inline).
    string sugerencias = System.Text.Json.JsonSerializer.Serialize(Model.Sugerencias.Select(s => new { d = s.Descripcion, c = s.CategoriaId, t = s.TarjetaId, m = s.Moneda.ToString() }));
}

<div class="page-head">
    <div>
        <span class="eyebrow"><a asp-action="Index" class="text-reset"><i class="bi bi-arrow-left"></i> Gastos del mes</a></span>
        <h1>@(editando ? "Editar gasto" : "Nuevo gasto")</h1>
        <p class="hide-sm">Si es una compra en cuotas, carga el monto de <strong>una cuota</strong>: la app la repite en cada mes hasta la última.</p>
    </div>
</div>

@if (Model.RecurrenteDescripcion != null)
{
    <div class="alert-x ok"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><div>Este gasto lo cargó el gasto fijo <strong>@Model.RecurrenteDescripcion</strong>. Los cambios aplican solo a este mes; para cambiar los próximos, edita el <a asp-controller="Recurrentes" asp-action="Index">gasto fijo</a>.</div></div>
}

<div asp-validation-summary="ModelOnly" class="alert-x err validation-box" role="alert"></div>

<form method="post" asp-action="@accion" asp-route-id="@Model.Id" data-validate novalidate id="form-gasto" data-sugerencias="@sugerencias">
    <div class="grid-2-1 align-start">
        <div class="card-x">
            <div class="form-section">
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="MontoCuota" class="form-label" id="lbl-monto">@(Model.EnCuotas ? "Monto de cada cuota" : "Monto")</label>
                        <div class="input-group input-group-lg">
                            <select asp-for="Moneda" class="form-select money-cur" aria-label="Moneda">
                                <option value="UYU">$ UYU</option>
                                <option value="USD">US$ USD</option>
                            </select>
                            <input asp-for="MontoCuota" class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" required autofocus
                                   value="@(Model.MontoCuota > 0 ? Model.MontoCuota.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                        </div>
                        <span asp-validation-for="MontoCuota" class="field-error"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Fecha" class="form-label">Fecha</label>
                        <input asp-for="Fecha" class="form-control form-control-lg" type="date" required />
                        <span asp-validation-for="Fecha" class="field-error"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <input asp-for="Descripcion" class="form-control" maxlength="120" placeholder="Ej.: Mercado Libre · auriculares" required list="lista-sugerencias" autocomplete="off" />
                        <datalist id="lista-sugerencias">
                            @foreach (var s in Model.Sugerencias)
                            {
                                <option value="@s.Descripcion"></option>
                            }
                        </datalist>
                        <div class="form-hint" id="hint-sugerencia" hidden><i class="bi bi-magic"></i> Completé categoría y medio de pago como la última vez.</div>
                        <span asp-validation-for="Descripcion" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section-title">Medio de pago</h2>
                @if (Model.Tarjetas.Count == 0)
                {
                    <p class="form-section-sub"><a asp-controller="Tarjetas" asp-action="Nueva">Crea una tarjeta</a> para verla acá.</p>
                }
                <div class="method-options" role="radiogroup" aria-label="Medio de pago">
                    @foreach (var t in Model.Tarjetas)
                    {
                        <div class="method-option">
                            <input type="radio" name="TarjetaId" id="tj-@t.Id" value="@t.Id" checked="@(Model.TarjetaId == t.Id)" data-cierre="@t.CierreEfectivo" />
                            <label for="tj-@t.Id">
                                <i class="bi @(t.Tipo == TipoTarjeta.Credito ? "bi-credit-card" : "bi-credit-card-2-front")" style="color:@Fmt.ColorSeguro(t.Color)" aria-hidden="true"></i>
                                <strong>@t.Nombre</strong><span>@Fmt.Tipo(t.Tipo)@(t.CierreEfectivo is int c ? $" · cierra el {c}" : "")@(t.Activa ? "" : " · inactiva")</span>
                            </label>
                        </div>
                    }
                    <div class="method-option">
                        <input type="radio" name="TarjetaId" id="tj-none" value="" checked="@(Model.TarjetaId == null)" />
                        <label for="tj-none"><i class="bi bi-cash-stack" aria-hidden="true"></i><strong>Efectivo</strong><span>o transferencia</span></label>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="CategoriaId" class="form-label">Categoría</label>
                        <select asp-for="CategoriaId" class="form-select">
                            <option value="">Sin categoría</option>
                            @foreach (var c in Model.Categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Comercio" class="form-label">Comercio <span class="text-muted-x">(opcional)</span></label>
                        <input asp-for="Comercio" class="form-control" maxlength="120" placeholder="Como figura en el estado de cuenta" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-check form-switch mb-1">
                    <input asp-for="EnCuotas" class="form-check-input" role="switch" data-toggle-cuotas />
                    <label asp-for="EnCuotas" class="form-check-label"><strong>Es una compra en cuotas</strong></label>
                </div>
                <p class="form-section-sub">Si la compra ya empezó (por ejemplo "5/6" en tu estado de cuenta), indica qué cuota se paga en el mes de la fecha.</p>
                <div class="row g-3" id="bloque-cuotas" @(Model.EnCuotas ? "" : "hidden")>
                    <div class="col-6 col-md-4">
                        <label asp-for="CantidadCuotas" class="form-label">Cantidad de cuotas</label>
                        <input asp-for="CantidadCuotas" class="form-control" type="number" min="1" max="72" step="1" inputmode="numeric" />
                        <span asp-validation-for="CantidadCuotas" class="field-error"></span>
                    </div>
                    <div class="col-6 col-md-4">
                        <label asp-for="CuotaActual" class="form-label">Cuota de este mes</label>
                        <input asp-for="CuotaActual" class="form-control" type="number" min="1" max="72" step="1" inputmode="numeric" />
                        <span asp-validation-for="CuotaActual" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <label asp-for="Notas" class="form-label">Notas <span class="text-muted-x">(opcional)</span></label>
                <textarea asp-for="Notas" class="form-control" rows="2" maxlength="500"></textarea>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" asp-action="Index">Cancelar</a>
                @if (!editando)
                {
                    <button type="submit" name="otro" value="1" class="btn btn-light"><i class="bi bi-plus-lg"></i>Guardar y cargar otro</button>
                }
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>@(editando ? "Guardar cambios" : "Guardar gasto")</button>
            </div>
        </div>

        <aside class="card-x summary-card" aria-labelledby="res-title" data-resumen-gasto>
            <div class="card-head"><h2 id="res-title">Resumen</h2></div>
            <div class="card-body-x">
                <ul class="summary-list">
                    <li><span id="s-lbl-cuota">Monto</span><strong id="s-cuota">—</strong></li>
                    <li><span>Cuotas</span><strong id="s-cant">1</strong></li>
                    <li><span id="s-lbl-desde">Primera cuota</span><strong id="s-desde">—</strong></li>
                    <li id="s-row-hasta"><span>Última cuota</span><strong id="s-hasta">—</strong></li>
                </ul>
                <div class="summary-total"><span>Total de la compra</span><strong id="s-total">—</strong></div>
                <div class="info-note mt-3" id="s-cierre" hidden><i class="bi bi-calendar-check" aria-hidden="true"></i><span></span></div>
                <div class="info-note mt-3"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Cada cuota suma en su mes. Pesos y dólares se totalizan por separado.</span></div>
            </div>
        </aside>
    </div>
</form>
