@{ var gid = "lg" + Guid.NewGuid().ToString("N")[..8]; }
<svg class="brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
        <linearGradient id="@gid" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
            <stop stop-color="#34D399" />
            <stop offset="1" stop-color="#047857" />
        </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#@gid)" />
    <rect x="8" y="16" width="4" height="8" rx="2" fill="#fff" fill-opacity=".55" />
    <rect x="14" y="12" width="4" height="12" rx="2" fill="#fff" fill-opacity=".8" />
    <rect x="20" y="8" width="4" height="16" rx="2" fill="#fff" />
</svg>
