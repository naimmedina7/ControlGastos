@{
    // Título de la pestaña: "Sección · Mis·Gastos". La portada usa uno propio para no repetir la marca.
    string titulo = ViewData["TituloCompleto"] as string ?? $"{ViewData["Title"] ?? "Inicio"} · Mis·Gastos";
    const string descripcion = "Tus tarjetas y tus cuotas, claras mes a mes. Gastos en pesos y dólares, cuotas que se reparten solas y reportes simples.";
    string origen = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
